# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/simars?schema=public"

# Required session signing secret. Generate a unique value for each environment:
#   openssl rand -hex 32
# Set the generated output as AUTH_SECRET; it must contain at least 32 random bytes.
AUTH_SECRET=

# Optional seed configuration. If seed:users is used, all values below are required.
# Use distinct usernames/emails and generate a unique 64-character hex password per account:
#   openssl rand -hex 32
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

INITIAL_USER_NAME=
INITIAL_USER_USERNAME=
INITIAL_USER_EMAIL=
INITIAL_USER_PASSWORD=

INITIAL_INACTIVE_NAME=
INITIAL_INACTIVE_USERNAME=
INITIAL_INACTIVE_EMAIL=
INITIAL_INACTIVE_PASSWORD=

